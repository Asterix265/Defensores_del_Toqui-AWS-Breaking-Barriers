# Copiar a apps/api/.env para desarrollo local. Credenciales solo para el Postgres de Docker.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://toqui:toqui_local@localhost:5432/toqui
AWS_REGION=us-east-1

# Modo local (definir-mvp-e1): sin AWS ni Cognito.
# AUTH_MODE=local usa la educadora fija de JAR-0001, o `Authorization: Bearer local:<educadora|directora>:<JAR-XXXX>`.
# En AWS: AUTH_MODE=cognito (por defecto) con COGNITO_USER_POOL_ID y COGNITO_CLIENT_ID.
AUTH_MODE=local
# inline: el pipeline corre dentro de la API con IA_PROVIDER=fake. aws: Step Functions (por defecto).
PIPELINE_MODE=inline
IA_PROVIDER=fake
# Carpeta con los CSV del dataset E-1, relativa a apps/api (no se copia al repositorio).
DATASET_DIR=../../../datos_publicos
# Secreto compartido con el pipeline para POST /interno/capturas/:id/* (mínimo 16 caracteres).
# PIPELINE_TOKEN=
# Bucket privado de capturas (audio y foto). En AWS lo inyecta ToquiApp.
# S3_BUCKET_CAPTURAS=
