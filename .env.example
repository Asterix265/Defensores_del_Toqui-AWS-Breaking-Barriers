# Copiar a apps/api/.env para desarrollo local. Credenciales solo para el Postgres de Docker.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://toqui:toqui_local@localhost:5432/toqui
AWS_REGION=us-east-1

# Modo local (definir-mvp-e1): sin AWS ni Cognito.
# AUTH_MODE=local usa la educadora fija de JAR-0001, o `Authorization: Bearer local:<educadora|directora>:<JAR-XXXX>`.
# En AWS: AUTH_MODE=cognito (por defecto) con COGNITO_USER_POOL_ID y COGNITO_CLIENT_ID.
AUTH_MODE=local
# inline: el pipeline corre dentro de la API. aws: Step Functions y Lambdas (por defecto).
PIPELINE_MODE=inline
# fake: borradores deterministas sin AWS. bedrock: Guardrail + Claude reales con el perfil `toqui`
# (en inline, audio y foto siguen con lecturas simuladas). Requiere BEDROCK_GUARDRAIL_* de `pnpm aws:env`.
IA_PROVIDER=fake
# Carpeta con los CSV del dataset E-1, relativa a apps/api o absoluta (no se copia al repositorio).
# También acepta s3://<bucket>/<prefijo>, que usa `pnpm aws:prod:seed` para cargar Aurora.
DATASET_DIR=../../../Desafio/dataset_e1_publico/datos_publicos
# Secreto compartido con el pipeline para POST /interno/capturas/:id/* (mínimo 16 caracteres).
# PIPELINE_TOKEN=

# AWS de desarrollo (stack ToquiDev). Completar con la salida de `pnpm aws:env`; vacías = sin usar.
AWS_PROFILE=toqui
S3_BUCKET_CAPTURAS=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
BEDROCK_MODEL_EXTRACCION=us.anthropic.claude-sonnet-5-5
BEDROCK_MODEL_RESUMEN=us.anthropic.claude-haiku-5-5
