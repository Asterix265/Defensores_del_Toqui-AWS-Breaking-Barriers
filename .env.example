# Copiar a apps/api/.env para desarrollo local. Credenciales solo para el Postgres de Docker.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://toqui:toqui_local@localhost:5432/toqui
AWS_REGION=us-east-1

# Autenticación. En local, `dev` acepta tokens `Bearer dev:<registrador|supervisor>:<id>`.
# En AWS: AUTH_MODO=cognito con el user pool y el client id de la app.
AUTH_MODO=dev
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=

# Bucket privado y cola de la Lambda de proceso. Sin ellos, /subidas responde 503 y las
# observaciones quedan pendientes (sin procesar). Obligatorios en producción.
# S3_BUCKET=
# SQS_QUEUE_URL=
# Endpoints alternativos para LocalStack o MinIO.
# S3_ENDPOINT=
# SQS_ENDPOINT=

# ZONA_HORARIA=America/Santiago
# PESO_EJEMPLO_REGISTRADOR=1
# PESO_EJEMPLO_SUPERVISOR=3
