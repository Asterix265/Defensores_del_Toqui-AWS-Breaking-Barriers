# Copiar a apps/api/.env para desarrollo local. Credenciales solo para el Postgres de Docker.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://toqui:toqui_local@localhost:5432/toqui
AWS_REGION=us-east-1

# AWS de desarrollo (stack ToquiDev). Completar con la salida de `pnpm aws:env`.
# La API todavía no los usa; se integran con el MVP (definir-mvp-e1).
AWS_PROFILE=toqui
S3_BUCKET_CAPTURAS=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
BEDROCK_MODEL_EXTRACCION=us.anthropic.claude-sonnet-5-5
BEDROCK_MODEL_RESUMEN=us.anthropic.claude-haiku-5-5
