# Copiar a apps/web/.env.local (ignorado por Git). No son secretos: el cliente web de Cognito
# no tiene secreto y estos IDs viajan en el bundle.
# Sin ellas, la web usa el modo local: ingreso de prueba sin token, para la API con AUTH_MODE=local.
# Con ellas, la API local debe correr con AUTH_MODE=cognito y los mismos IDs (`pnpm aws:env`).
# En Amplify Hosting las define `pnpm aws:prod:amplify`.
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
