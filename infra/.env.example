# Copiar a infra/.env (no versionar). Contraseña de los usuarios sintéticos de prueba de Cognito:
# mínimo 12 caracteres con mayúsculas, minúsculas y números. Se comparte por un canal privado del equipo.
TOQUI_DEV_PASSWORD=

# Opcional: usuario personal de prueba (grupo educadora, JAR-0001). Si ambos están definidos,
# `pnpm aws:smoke` ingresa con él en vez de la educadora compartida.
TOQUI_PERSONAL_EMAIL=
TOQUI_PERSONAL_PASSWORD=
