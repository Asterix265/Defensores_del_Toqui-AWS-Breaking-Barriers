{
  "name": "defensores-del-toqui",
  "private": true,
  "description": "Monorepo del equipo Defensores del Toqui — AWS Breaking Barriers Chile 2026, desafío E-1",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "pnpm install && pnpm --filter @toqui/shared build && pnpm --filter @toqui/api prisma:generate",
    "dev": "pnpm --filter @toqui/shared build && pnpm --parallel --filter @toqui/api --filter @toqui/web dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:deploy": "pnpm --filter @toqui/api prisma:deploy",
    "db:seed": "pnpm --filter @toqui/shared build && pnpm --filter @toqui/api build && pnpm --filter @toqui/api seed",
    "db:migrate": "pnpm --filter @toqui/api prisma:migrate",
    "contract": "pnpm --filter @toqui/shared build && pnpm --filter @toqui/api openapi && pnpm --filter @toqui/web contract",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "infra:synth": "pnpm --filter @toqui/infra synth",
    "aws:bootstrap": "pnpm --filter @toqui/infra aws:bootstrap",
    "aws:deploy": "pnpm --filter @toqui/infra aws:deploy",
    "aws:diff": "pnpm --filter @toqui/infra aws:diff",
    "aws:destroy": "pnpm --filter @toqui/infra aws:destroy",
    "aws:users": "pnpm --filter @toqui/infra aws:users",
    "aws:env": "pnpm --filter @toqui/infra aws:env",
    "aws:smoke": "pnpm --filter @toqui/infra aws:smoke",
    "aws:prod:deploy": "pnpm --filter @toqui/shared build && pnpm --filter @toqui/pipeline build && pnpm --filter @toqui/infra aws:prod:deploy",
    "aws:prod:diff": "pnpm --filter @toqui/infra aws:prod:diff",
    "aws:prod:destroy": "pnpm --filter @toqui/infra aws:prod:destroy",
    "aws:prod:users": "pnpm --filter @toqui/infra aws:prod:users",
    "aws:prod:env": "pnpm --filter @toqui/infra aws:prod:env",
    "aws:prod:smoke": "pnpm --filter @toqui/infra aws:prod:smoke",
    "aws:prod:seed": "pnpm --filter @toqui/infra aws:prod:seed",
    "aws:prod:amplify": "pnpm --filter @toqui/infra aws:prod:amplify"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
