  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1151.0",
    "@toqui/shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
