{
  "name": "@toqui/ia",
  "version": "0.0.0",
  "private": true,
  "description": "Módulo de IA puro: nota → borrador con manifestaciones citadas",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
